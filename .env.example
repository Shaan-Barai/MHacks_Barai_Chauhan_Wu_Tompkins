# Copy to .env and fill in. Server-side only — never commit real values,
# never expose any of these to the browser.

# Gemini (vision + suggestions)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# SAM 2.1 segmentation worker (vision/sam/worker.py). With a Gemini key the
# backend segments every classified food region here and counts mask pixels.
SAM_WORKER_URL=http://127.0.0.1:8790

# Gemini localization passes per photo (1 or 2; two passes merged by IoU).
GEMINI_PASSES=2
# Sampling determinism (D5): fixed seed (integer, or "off"); optional caps, unset = provider default.
GEMINI_SEED=42
# GEMINI_TOP_K=1
# GEMINI_TOP_P=0.1
# SAM worker request timeout (ms).
SAM_TIMEOUT_MS=60000

# SpacetimeDB (local `spacetime start`). Leave SPACETIMEDB_URI empty to use
# the backend's in-memory store instead. The token is the local identity that
# published the module (see README setup step 3); it lets the backend read the
# private tables. `scrap` is the v2 database (pixels only, relative impact
# points, target-dish counting); `scrap-bigplan` is retired.
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_MODULE=scrap
SPACETIMEDB_TOKEN=

# Supabase project (Project Settings -> API). SUPABASE_URL is the API address,
# not a dashboard link. The service role (secret) key is SERVER ONLY: never put
# it in a VITE_* variable or anything the browser loads. The anon (publishable)
# key is safe for the dashboard; RLS limits it to reading dashboard tables.
# SUPABASE_DB_URL (Connect -> Session pooler) is only for applying migrations
# (`npx supabase db push --db-url "$SUPABASE_DB_URL"`) and the one-time import.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Object storage: 'supabase' (private Supabase Storage bucket), 'local-dev' for
# an offline filesystem store under OBJECT_STORAGE_LOCAL_DIR, or legacy 'r2'.
# With 'supabase' the container is the bucket created by the storage migration;
# clients only ever receive short-lived signed upload/read URLs.
OBJECT_STORAGE_PROVIDER=supabase
OBJECT_STORAGE_CONTAINER=scrap-images
# Prepended to every object key. Leave empty normally; tests use 'test/' and
# delete that prefix afterwards. (R2_KEY_PREFIX is still read as a fallback.)
OBJECT_STORAGE_KEY_PREFIX=
# Legacy Cloudflare R2 settings (provider 'r2'), kept until R2 support is removed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
OBJECT_STORAGE_LOCAL_DIR=.local-storage

# Optional shared secret the SAM worker requires in the X-Worker-Token header.
WORKER_TOKEN=

# Auth (IT_4 I11). Reads are public; every mutation needs the bearer token
# (camera bridge, scripts) or a dashboard admin session from the passcode.
# Required when NODE_ENV=production; deploy/local.sh generates them into
# deploy/.run/local-secrets.env if unset here.
SCRAP_INGEST_TOKEN=
SCRAP_ADMIN_PASSCODE=
# >= 16 random chars, signs the admin session cookie.
SESSION_SECRET=
# Secure cookie defaults to on in production; set 0 for plain http://localhost
# browsers that drop Secure cookies (e.g. Safari).
SESSION_COOKIE_SECURE=
# Express trust proxy hop count (set 1 behind a Cloudflare Tunnel).
TRUST_PROXY=

# READ_ONLY=1: the read-only public site on the offsite server (docs/deploy-server.md).
# Every upload/edit answers 403 READ_ONLY, Gemini/SAM/camera are off, and the auth
# secrets above are not required. Leave empty on the Mac.
READ_ONLY=

# Simulated attendance (prototype only; labeled 'simulated' everywhere)
ATTENDANCE_MIN=300
ATTENDANCE_MAX=1200
ATTENDANCE_SEED=

# Uno Q camera (Logitech C920s on the Arduino Uno Q), reached over SSH with a
# key only (never a password). The board's IP can change when it rejoins
# Wi-Fi: update CAMERA_HOST here, nothing in code. Set up the key once with
#   ssh-copy-id -i ~/.ssh/scrap_unoq.pub arduino@<board-ip>
CAMERA_HOST=192.168.1.50
CAMERA_USER=arduino
CAMERA_SSH_KEY=~/.ssh/scrap_unoq
# The C920 appears as several /dev/video nodes; the capture node is found by
# this name in `v4l2-ctl --list-devices`. CAMERA_DEVICE pins a node instead.
CAMERA_DEVICE_NAME=C920
CAMERA_DEVICE=
CAMERA_DEVICE_ID=uno-q-c920

# Which meal a scan belongs to when take-photo gets no --service (hall local time).
HALL_ID=hall-main
MEAL_WINDOWS=breakfast=05:00-10:59,lunch=11:00-15:59,dinner=16:00-22:59

# Sample history for the dashboard charts: `cd backend && npm run demo:seed`
# fills ~14 days when DEMO_SEED=1; `npm run demo:clear` removes all of it.
DEMO_SEED=
