# Server-side configuration; never put keys in frontend bundles.
GEMINI_API_KEY=
GEMINI_MODEL=

SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
SPACETIMEDB_MODULE=mhacks-kdmqp
SPACETIMEDB_TOKEN=

OBJECT_STORAGE_PROVIDER=r2
# Intended plural name. Bucket mapping/parsing belongs to the future backend adapter.
OBJECT_STORAGE_CONTAINERS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

ATTENDANCE_MIN=300
ATTENDANCE_MAX=1200
ATTENDANCE_SEED=scrap-seven-days-v1
