{
  "name": "mhacks",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && node scripts/serve-ui.mjs",
    "start": "node scripts/serve-ui.mjs",
    "build": "npm run build:db && npm run build:ui",
    "build:db": "esbuild src/main.ts --bundle --platform=node --outfile=dist/main.js --format=esm",
    "dev:db": "npm run build:db && node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/main.js",
    "build:ui": "node scripts/build-ui.mjs",
    "demo:generate": "node data/generate-demo.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p spacetimedb/tsconfig.json",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spacetimedb": "2.10.*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.0",
    "typescript": "~5.6.2"
  }
}
