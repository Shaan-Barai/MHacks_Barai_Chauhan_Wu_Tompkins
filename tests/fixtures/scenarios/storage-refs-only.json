      {
        "objectId": "img_01J9ABCDXYZ",
        "provider": "local-dev",
        "container": "scrap-images",
        "objectKey": "captures/2026-10-03/cap_01J9ABCD.jpg",
        "mimeType": "image/jpeg",
        "sizeBytes": 183422,
        "widthPx": 1024,
        "heightPx": 1024,
        "state": "finalized",
        "association": { "kind": "capture", "id": "cap_01J9ABCD" }
      }
    ],
    "forbiddenFieldsIfPresent": [
      "bytes",
      "base64",
      "imageBase64",
      "blob",
      "dataUrl",
      "contentBase64"
    ],
    "accessResponse": {
      "objectId": "img_01J9ABCDXYZ",
