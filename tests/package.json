{
  "name": "scrap-agent8-tests",
  "private": true,
  "type": "module",
  "description": "Agent 8 fixture validation and cross-system checks (no feature-module ownership).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test integration/*.test.mjs e2e/*.test.mjs",
    "test:integration": "node scripts/build.mjs && node --env-file-if-exists=../.env --test integration/*.test.mjs system/*.test.mjs",
    "test:e2e": "node --test e2e/*.test.mjs",
    "test:e2e:scrap": "node --env-file-if-exists=../.env --test e2e/scrap-live.test.mjs",
    "test:e2e:calibration": "node --env-file-if-exists=../.env --test e2e/calibration-live.test.mjs",
    "build": "node scripts/build.mjs",
    "test:unit": "node scripts/unit.mjs",
    "test:images": "node scripts/build.mjs && RUN_LIVE=1 node --env-file-if-exists=../.env --test --test-timeout=3600000 live/images.test.mjs",
    "test:camera": "node scripts/build.mjs && RUN_CAMERA=1 node --env-file-if-exists=../.env camera/run.mjs",
    "test:smoke": "node scripts/build.mjs && node --env-file-if-exists=../.env --test --test-timeout=300000 smoke/dashboard.smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
