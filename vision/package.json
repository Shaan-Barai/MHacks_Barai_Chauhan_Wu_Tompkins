{
  "name": "@scrap/vision",
  "version": "0.1.0",
  "private": true,
  "description": "Agent 4 - Gemini gateway, menu-constrained classification, and pixel-area waste measurement for the Scrap prototype.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "smoke": "npm run build && node --env-file=../.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.0"
  }
}
